<?xml version="1.0" encoding="utf-8"?>
<MixxxControllerPreset mixxxVersion="2.4" schemaVersion="1">
    <info>
        <name>Gemini Slate 4 / Gemini Serato Slate 4</name>
        <author>Cursor AI</author>
        <description>Four deck MIDI mapping for Gemini Slate 4 (SLATE4) on Mixxx 2.4+. Generated from MIDI-OX log on MIDI channel 1 for Deck 1 and mirrored to channels 2/3/4 for Decks 2/3/4. Mixer CCs share global MIDI channel 4 (status 0xB3) with per-deck CC numbers.</description>
    </info>
    <controller id="SLATE4">
        <scriptfiles>
            <file filename="Gemini-Serato-Slate-script.js" functionprefix="GeminiSlate"/>
        </scriptfiles>
        <controls>

            <!-- ================================================== -->
            <!-- DECK 1  -  status 0x90 / 0xB0  (MIDI channel 1)    -->
            <!-- ================================================== -->

            <!-- Local Shift (per deck) -->
            <control><group>[Channel1]</group><key>GeminiSlate.shift</key><status>0x90</status><midino>0x37</midino><options><Script-Binding/></options></control>

            <!-- Pads, Hot Cue mode (no shift) -->
            <control><group>[Channel1]</group><key>GeminiSlate.padHotcue</key><status>0x90</status><midino>0x06</midino><options><Script-Binding/></options></control>
            <control><group>[Channel1]</group><key>GeminiSlate.padHotcue</key><status>0x90</status><midino>0x09</midino><options><Script-Binding/></options></control>
            <control><group>[Channel1]</group><key>GeminiSlate.padHotcue</key><status>0x90</status><midino>0x0C</midino><options><Script-Binding/></options></control>
            <control><group>[Channel1]</group><key>GeminiSlate.padHotcue</key><status>0x90</status><midino>0x0F</midino><options><Script-Binding/></options></control>
            <control><group>[Channel1]</group><key>GeminiSlate.padHotcue</key><status>0x90</status><midino>0x12</midino><options><Script-Binding/></options></control>
            <control><group>[Channel1]</group><key>GeminiSlate.padHotcue</key><status>0x90</status><midino>0x15</midino><options><Script-Binding/></options></control>
            <control><group>[Channel1]</group><key>GeminiSlate.padHotcue</key><status>0x90</status><midino>0x18</midino><options><Script-Binding/></options></control>
            <control><group>[Channel1]</group><key>GeminiSlate.padHotcue</key><status>0x90</status><midino>0x1B</midino><options><Script-Binding/></options></control>

            <!-- Pads, Sampler / shifted layer (when local Shift held) -->
            <control><group>[Channel1]</group><key>GeminiSlate.padSampler</key><status>0x90</status><midino>0x55</midino><options><Script-Binding/></options></control>
            <control><group>[Channel1]</group><key>GeminiSlate.padSampler</key><status>0x90</status><midino>0x56</midino><options><Script-Binding/></options></control>
            <control><group>[Channel1]</group><key>GeminiSlate.padSampler</key><status>0x90</status><midino>0x57</midino><options><Script-Binding/></options></control>
            <control><group>[Channel1]</group><key>GeminiSlate.padSampler</key><status>0x90</status><midino>0x58</midino><options><Script-Binding/></options></control>
            <control><group>[Channel1]</group><key>GeminiSlate.padSampler</key><status>0x90</status><midino>0x59</midino><options><Script-Binding/></options></control>
            <control><group>[Channel1]</group><key>GeminiSlate.padSampler</key><status>0x90</status><midino>0x5A</midino><options><Script-Binding/></options></control>
            <control><group>[Channel1]</group><key>GeminiSlate.padSampler</key><status>0x90</status><midino>0x5B</midino><options><Script-Binding/></options></control>
            <control><group>[Channel1]</group><key>GeminiSlate.padSampler</key><status>0x90</status><midino>0x5C</midino><options><Script-Binding/></options></control>

            <!-- Top buttons (best-guess based on photo) -->
            <control><group>[Channel1]</group><key>GeminiSlate.keyLock</key><status>0x90</status><midino>0x04</midino><options><Script-Binding/></options></control>
            <control><group>[Channel1]</group><key>GeminiSlate.fx1</key><status>0x90</status><midino>0x01</midino><options><Script-Binding/></options></control>
            <control><group>[Channel1]</group><key>GeminiSlate.fx2</key><status>0x90</status><midino>0x02</midino><options><Script-Binding/></options></control>
            <control><group>[Channel1]</group><key>GeminiSlate.fx3</key><status>0x90</status><midino>0x03</midino><options><Script-Binding/></options></control>
            <control><group>[Channel1]</group><key>GeminiSlate.pflButton</key><status>0x90</status><midino>0x05</midino><options><Script-Binding/></options></control>

            <!-- Loop in / out (notes seen with shift held in log) -->
            <control><group>[Channel1]</group><key>GeminiSlate.loopIn</key><status>0x90</status><midino>0x3C</midino><options><Script-Binding/></options></control>
            <control><group>[Channel1]</group><key>GeminiSlate.loopOut</key><status>0x90</status><midino>0x3E</midino><options><Script-Binding/></options></control>
            <control><group>[Channel1]</group><key>GeminiSlate.loopExit</key><status>0x90</status><midino>0x3D</midino><options><Script-Binding/></options></control>
            <control><group>[Channel1]</group><key>GeminiSlate.loopHalve</key><status>0x90</status><midino>0x3F</midino><options><Script-Binding/></options></control>

