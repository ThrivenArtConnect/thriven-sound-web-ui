            <control><group>[Channel1]</group><key>GeminiSlate.playButton</key><status>0x90</status><midino>0x38</midino><options><Script-Binding/></options></control>
            <control><group>[Channel1]</group><key>GeminiSlate.syncButton</key><status>0x90</status><midino>0x54</midino><options><Script-Binding/></options></control>

            <!-- Jog wheel -->
            <control><group>[Channel1]</group><key>GeminiSlate.wheelTouch</key><status>0x90</status><midino>0x41</midino><options><Script-Binding/></options></control>
            <control><group>[Channel1]</group><key>GeminiSlate.wheelTurn</key><status>0xB0</status><midino>0x04</midino><options><Script-Binding/></options></control>

            <!-- Pitch / Rate fader (deck channel) -->
            <control><group>[Channel1]</group><key>GeminiSlate.rate</key><status>0xB0</status><midino>0x07</midino><options><Script-Binding/></options></control>
            <!-- Optional pregain on deck channel (CC 8) -->
            <control><group>[Channel1]</group><key>GeminiSlate.pregain</key><status>0xB0</status><midino>0x08</midino><options><Script-Binding/></options></control>

            <!-- ================================================== -->
