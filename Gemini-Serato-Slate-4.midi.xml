            <control><group>[EqualizerRack1_[Channel3]_Effect1]</group><key>parameter2</key><status>0xB3</status><midino>0x15</midino></control>
            <control><group>[EqualizerRack1_[Channel3]_Effect1]</group><key>parameter1</key><status>0xB3</status><midino>0x19</midino></control>

            <control><group>[Channel4]</group><key>volume</key><status>0xB3</status><midino>0x0A</midino></control>
