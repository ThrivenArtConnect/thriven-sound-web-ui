<?xml version="1.0" encoding="utf-8"?>
<MixxxControllerPreset mixxxVersion="2.4" schemaVersion="1">
    <info>
        <name>Gemini Slate 4 / Gemini Serato Slate 4</name>
        <author>Cursor AI</author>
        <description>Final 4-deck mapping for the Gemini Slate 4 (SLATE4) on Mixxx 2.4+. Uses direct XML bindings for buttons / pads / mixer (cleaner and more reliable) and a small JS script only for jog scratching, the bipolar pitch / crossfader scaling and shift state.</description>
    </info>
    <controller id="SLATE4">
        <scriptfiles>
            <file filename="Gemini-Serato-Slate-script.js" functionprefix="GeminiSlate"/>
        </scriptfiles>
        <controls>

            <!-- ====================================================== -->
            <!-- DECK 1  -  status 0x90 / 0xB0                          -->
            <!-- ====================================================== -->

            <!-- Local shift -->
            <control><group>[Channel1]</group><key>GeminiSlate.shift</key><status>0x90</status><midino>0x37</midino><options><Script-Binding/></options></control>

            <!-- Pads (Hot Cue) -->
            <control><group>[Channel1]</group><key>hotcue_1_activate</key><status>0x90</status><midino>0x06</midino></control>
            <control><group>[Channel1]</group><key>hotcue_2_activate</key><status>0x90</status><midino>0x09</midino></control>
            <control><group>[Channel1]</group><key>hotcue_3_activate</key><status>0x90</status><midino>0x0C</midino></control>
            <control><group>[Channel1]</group><key>hotcue_4_activate</key><status>0x90</status><midino>0x0F</midino></control>
            <control><group>[Channel1]</group><key>hotcue_5_activate</key><status>0x90</status><midino>0x12</midino></control>
            <control><group>[Channel1]</group><key>hotcue_6_activate</key><status>0x90</status><midino>0x15</midino></control>
            <control><group>[Channel1]</group><key>hotcue_7_activate</key><status>0x90</status><midino>0x18</midino></control>
            <control><group>[Channel1]</group><key>hotcue_8_activate</key><status>0x90</status><midino>0x1B</midino></control>

            <!-- Pads (Shift layer = Hot Cue Clear) -->
            <control><group>[Channel1]</group><key>hotcue_1_clear</key><status>0x90</status><midino>0x55</midino></control>
            <control><group>[Channel1]</group><key>hotcue_2_clear</key><status>0x90</status><midino>0x56</midino></control>
            <control><group>[Channel1]</group><key>hotcue_3_clear</key><status>0x90</status><midino>0x57</midino></control>
            <control><group>[Channel1]</group><key>hotcue_4_clear</key><status>0x90</status><midino>0x58</midino></control>
            <control><group>[Channel1]</group><key>hotcue_5_clear</key><status>0x90</status><midino>0x59</midino></control>
            <control><group>[Channel1]</group><key>hotcue_6_clear</key><status>0x90</status><midino>0x5A</midino></control>
            <control><group>[Channel1]</group><key>hotcue_7_clear</key><status>0x90</status><midino>0x5B</midino></control>
            <control><group>[Channel1]</group><key>hotcue_8_clear</key><status>0x90</status><midino>0x5C</midino></control>

            <!-- Top buttons -->
            <control><group>[Channel1]</group><key>keylock</key><status>0x90</status><midino>0x04</midino></control>
            <control><group>[EffectRack1_EffectUnit1]</group><key>group_[Channel1]_enable</key><status>0x90</status><midino>0x01</midino></control>
            <control><group>[EffectRack1_EffectUnit2]</group><key>group_[Channel1]_enable</key><status>0x90</status><midino>0x02</midino></control>
            <control><group>[EffectRack1_EffectUnit3]</group><key>group_[Channel1]_enable</key><status>0x90</status><midino>0x03</midino></control>
            <control><group>[Channel1]</group><key>pfl</key><status>0x90</status><midino>0x05</midino></control>

            <!-- Loops -->
            <control><group>[Channel1]</group><key>loop_in</key><status>0x90</status><midino>0x3C</midino></control>
            <control><group>[Channel1]</group><key>loop_out</key><status>0x90</status><midino>0x3E</midino></control>
            <control><group>[Channel1]</group><key>reloop_toggle</key><status>0x90</status><midino>0x3D</midino></control>
            <control><group>[Channel1]</group><key>loop_halve</key><status>0x90</status><midino>0x3F</midino></control>

            <!-- Transport -->
            <control><group>[Channel1]</group><key>cue_default</key><status>0x90</status><midino>0x39</midino></control>
            <control><group>[Channel1]</group><key>play</key><status>0x90</status><midino>0x38</midino></control>
            <control><group>[Channel1]</group><key>beatsync</key><status>0x90</status><midino>0x54</midino></control>

            <!-- Jog (script handled) -->
            <control><group>[Channel1]</group><key>GeminiSlate.wheelTouch</key><status>0x90</status><midino>0x41</midino><options><Script-Binding/></options></control>
            <control><group>[Channel1]</group><key>GeminiSlate.wheelTurn</key><status>0xB0</status><midino>0x04</midino><options><Script-Binding/></options></control>

            <!-- Pitch / pregain (script handled, bipolar) -->
            <control><group>[Channel1]</group><key>GeminiSlate.rate</key><status>0xB0</status><midino>0x07</midino><options><Script-Binding/></options></control>
            <control><group>[Channel1]</group><key>pregain</key><status>0xB0</status><midino>0x08</midino></control>

            <!-- ====================================================== -->
            <!-- DECK 2  -  status 0x91 / 0xB1                          -->
            <!-- ====================================================== -->

            <control><group>[Channel2]</group><key>GeminiSlate.shift</key><status>0x91</status><midino>0x37</midino><options><Script-Binding/></options></control>

            <control><group>[Channel2]</group><key>hotcue_1_activate</key><status>0x91</status><midino>0x06</midino></control>
            <control><group>[Channel2]</group><key>hotcue_2_activate</key><status>0x91</status><midino>0x09</midino></control>
            <control><group>[Channel2]</group><key>hotcue_3_activate</key><status>0x91</status><midino>0x0C</midino></control>
            <control><group>[Channel2]</group><key>hotcue_4_activate</key><status>0x91</status><midino>0x0F</midino></control>
            <control><group>[Channel2]</group><key>hotcue_5_activate</key><status>0x91</status><midino>0x12</midino></control>
            <control><group>[Channel2]</group><key>hotcue_6_activate</key><status>0x91</status><midino>0x15</midino></control>
            <control><group>[Channel2]</group><key>hotcue_7_activate</key><status>0x91</status><midino>0x18</midino></control>
            <control><group>[Channel2]</group><key>hotcue_8_activate</key><status>0x91</status><midino>0x1B</midino></control>

            <control><group>[Channel2]</group><key>hotcue_1_clear</key><status>0x91</status><midino>0x55</midino></control>
            <control><group>[Channel2]</group><key>hotcue_2_clear</key><status>0x91</status><midino>0x56</midino></control>
            <control><group>[Channel2]</group><key>hotcue_3_clear</key><status>0x91</status><midino>0x57</midino></control>
            <control><group>[Channel2]</group><key>hotcue_4_clear</key><status>0x91</status><midino>0x58</midino></control>
            <control><group>[Channel2]</group><key>hotcue_5_clear</key><status>0x91</status><midino>0x59</midino></control>
            <control><group>[Channel2]</group><key>hotcue_6_clear</key><status>0x91</status><midino>0x5A</midino></control>
            <control><group>[Channel2]</group><key>hotcue_7_clear</key><status>0x91</status><midino>0x5B</midino></control>
            <control><group>[Channel2]</group><key>hotcue_8_clear</key><status>0x91</status><midino>0x5C</midino></control>

            <control><group>[Channel2]</group><key>keylock</key><status>0x91</status><midino>0x04</midino></control>
            <control><group>[EffectRack1_EffectUnit1]</group><key>group_[Channel2]_enable</key><status>0x91</status><midino>0x01</midino></control>
            <control><group>[EffectRack1_EffectUnit2]</group><key>group_[Channel2]_enable</key><status>0x91</status><midino>0x02</midino></control>
            <control><group>[EffectRack1_EffectUnit3]</group><key>group_[Channel2]_enable</key><status>0x91</status><midino>0x03</midino></control>
            <control><group>[Channel2]</group><key>pfl</key><status>0x91</status><midino>0x05</midino></control>

            <control><group>[Channel2]</group><key>loop_in</key><status>0x91</status><midino>0x3C</midino></control>
            <control><group>[Channel2]</group><key>loop_out</key><status>0x91</status><midino>0x3E</midino></control>
            <control><group>[Channel2]</group><key>reloop_toggle</key><status>0x91</status><midino>0x3D</midino></control>
            <control><group>[Channel2]</group><key>loop_halve</key><status>0x91</status><midino>0x3F</midino></control>

            <control><group>[Channel2]</group><key>cue_default</key><status>0x91</status><midino>0x39</midino></control>
            <control><group>[Channel2]</group><key>play</key><status>0x91</status><midino>0x38</midino></control>
            <control><group>[Channel2]</group><key>beatsync</key><status>0x91</status><midino>0x54</midino></control>

            <control><group>[Channel2]</group><key>GeminiSlate.wheelTouch</key><status>0x91</status><midino>0x41</midino><options><Script-Binding/></options></control>
            <control><group>[Channel2]</group><key>GeminiSlate.wheelTurn</key><status>0xB1</status><midino>0x04</midino><options><Script-Binding/></options></control>

            <control><group>[Channel2]</group><key>GeminiSlate.rate</key><status>0xB1</status><midino>0x07</midino><options><Script-Binding/></options></control>
            <control><group>[Channel2]</group><key>pregain</key><status>0xB1</status><midino>0x08</midino></control>

            <!-- ====================================================== -->
            <!-- DECK 3  -  status 0x92 / 0xB2                          -->
            <!-- ====================================================== -->

            <control><group>[Channel3]</group><key>GeminiSlate.shift</key><status>0x92</status><midino>0x37</midino><options><Script-Binding/></options></control>

            <control><group>[Channel3]</group><key>hotcue_1_activate</key><status>0x92</status><midino>0x06</midino></control>
            <control><group>[Channel3]</group><key>hotcue_2_activate</key><status>0x92</status><midino>0x09</midino></control>
            <control><group>[Channel3]</group><key>hotcue_3_activate</key><status>0x92</status><midino>0x0C</midino></control>
            <control><group>[Channel3]</group><key>hotcue_4_activate</key><status>0x92</status><midino>0x0F</midino></control>
            <control><group>[Channel3]</group><key>hotcue_5_activate</key><status>0x92</status><midino>0x12</midino></control>
            <control><group>[Channel3]</group><key>hotcue_6_activate</key><status>0x92</status><midino>0x15</midino></control>
            <control><group>[Channel3]</group><key>hotcue_7_activate</key><status>0x92</status><midino>0x18</midino></control>
            <control><group>[Channel3]</group><key>hotcue_8_activate</key><status>0x92</status><midino>0x1B</midino></control>

            <control><group>[Channel3]</group><key>hotcue_1_clear</key><status>0x92</status><midino>0x55</midino></control>
            <control><group>[Channel3]</group><key>hotcue_2_clear</key><status>0x92</status><midino>0x56</midino></control>
            <control><group>[Channel3]</group><key>hotcue_3_clear</key><status>0x92</status><midino>0x57</midino></control>
            <control><group>[Channel3]</group><key>hotcue_4_clear</key><status>0x92</status><midino>0x58</midino></control>
            <control><group>[Channel3]</group><key>hotcue_5_clear</key><status>0x92</status><midino>0x59</midino></control>
            <control><group>[Channel3]</group><key>hotcue_6_clear</key><status>0x92</status><midino>0x5A</midino></control>
            <control><group>[Channel3]</group><key>hotcue_7_clear</key><status>0x92</status><midino>0x5B</midino></control>
            <control><group>[Channel3]</group><key>hotcue_8_clear</key><status>0x92</status><midino>0x5C</midino></control>

            <control><group>[Channel3]</group><key>keylock</key><status>0x92</status><midino>0x04</midino></control>
            <control><group>[EffectRack1_EffectUnit1]</group><key>group_[Channel3]_enable</key><status>0x92</status><midino>0x01</midino></control>
            <control><group>[EffectRack1_EffectUnit2]</group><key>group_[Channel3]_enable</key><status>0x92</status><midino>0x02</midino></control>
            <control><group>[EffectRack1_EffectUnit3]</group><key>group_[Channel3]_enable</key><status>0x92</status><midino>0x03</midino></control>
            <control><group>[Channel3]</group><key>pfl</key><status>0x92</status><midino>0x05</midino></control>

            <control><group>[Channel3]</group><key>loop_in</key><status>0x92</status><midino>0x3C</midino></control>
            <control><group>[Channel3]</group><key>loop_out</key><status>0x92</status><midino>0x3E</midino></control>
            <control><group>[Channel3]</group><key>reloop_toggle</key><status>0x92</status><midino>0x3D</midino></control>
            <control><group>[Channel3]</group><key>loop_halve</key><status>0x92</status><midino>0x3F</midino></control>

            <control><group>[Channel3]</group><key>cue_default</key><status>0x92</status><midino>0x39</midino></control>
            <control><group>[Channel3]</group><key>play</key><status>0x92</status><midino>0x38</midino></control>
            <control><group>[Channel3]</group><key>beatsync</key><status>0x92</status><midino>0x54</midino></control>

            <control><group>[Channel3]</group><key>GeminiSlate.wheelTouch</key><status>0x92</status><midino>0x41</midino><options><Script-Binding/></options></control>
            <control><group>[Channel3]</group><key>GeminiSlate.wheelTurn</key><status>0xB2</status><midino>0x04</midino><options><Script-Binding/></options></control>

            <control><group>[Channel3]</group><key>GeminiSlate.rate</key><status>0xB2</status><midino>0x07</midino><options><Script-Binding/></options></control>
            <control><group>[Channel3]</group><key>pregain</key><status>0xB2</status><midino>0x08</midino></control>

            <!-- ====================================================== -->
            <!-- DECK 4  -  status 0x93 / 0xB3 (shares ch4 with global) -->
            <!-- We avoid notes/CCs already used by global on ch4.       -->
            <!-- ====================================================== -->

            <control><group>[Channel4]</group><key>GeminiSlate.shift</key><status>0x93</status><midino>0x37</midino><options><Script-Binding/></options></control>

            <control><group>[Channel4]</group><key>hotcue_1_activate</key><status>0x93</status><midino>0x06</midino></control>
            <control><group>[Channel4]</group><key>hotcue_2_activate</key><status>0x93</status><midino>0x09</midino></control>
            <control><group>[Channel4]</group><key>hotcue_3_activate</key><status>0x93</status><midino>0x0C</midino></control>
            <control><group>[Channel4]</group><key>hotcue_4_activate</key><status>0x93</status><midino>0x0F</midino></control>
            <control><group>[Channel4]</group><key>hotcue_5_activate</key><status>0x93</status><midino>0x12</midino></control>
            <control><group>[Channel4]</group><key>hotcue_6_activate</key><status>0x93</status><midino>0x15</midino></control>
            <control><group>[Channel4]</group><key>hotcue_7_activate</key><status>0x93</status><midino>0x18</midino></control>
            <control><group>[Channel4]</group><key>hotcue_8_activate</key><status>0x93</status><midino>0x1B</midino></control>

            <control><group>[Channel4]</group><key>hotcue_1_clear</key><status>0x93</status><midino>0x55</midino></control>
            <control><group>[Channel4]</group><key>hotcue_2_clear</key><status>0x93</status><midino>0x56</midino></control>
            <control><group>[Channel4]</group><key>hotcue_3_clear</key><status>0x93</status><midino>0x57</midino></control>
            <control><group>[Channel4]</group><key>hotcue_4_clear</key><status>0x93</status><midino>0x58</midino></control>
            <control><group>[Channel4]</group><key>hotcue_5_clear</key><status>0x93</status><midino>0x59</midino></control>
            <control><group>[Channel4]</group><key>hotcue_6_clear</key><status>0x93</status><midino>0x5A</midino></control>
            <control><group>[Channel4]</group><key>hotcue_7_clear</key><status>0x93</status><midino>0x5B</midino></control>
            <control><group>[Channel4]</group><key>hotcue_8_clear</key><status>0x93</status><midino>0x5C</midino></control>

            <control><group>[Channel4]</group><key>keylock</key><status>0x93</status><midino>0x04</midino></control>
            <control><group>[EffectRack1_EffectUnit2]</group><key>group_[Channel4]_enable</key><status>0x93</status><midino>0x02</midino></control>
            <control><group>[Channel4]</group><key>pfl</key><status>0x93</status><midino>0x05</midino></control>

            <control><group>[Channel4]</group><key>loop_in</key><status>0x93</status><midino>0x3C</midino></control>
            <control><group>[Channel4]</group><key>loop_out</key><status>0x93</status><midino>0x3E</midino></control>
            <control><group>[Channel4]</group><key>reloop_toggle</key><status>0x93</status><midino>0x3D</midino></control>
            <control><group>[Channel4]</group><key>loop_halve</key><status>0x93</status><midino>0x3F</midino></control>

            <control><group>[Channel4]</group><key>cue_default</key><status>0x93</status><midino>0x39</midino></control>
            <control><group>[Channel4]</group><key>play</key><status>0x93</status><midino>0x38</midino></control>
            <control><group>[Channel4]</group><key>beatsync</key><status>0x93</status><midino>0x54</midino></control>

            <control><group>[Channel4]</group><key>GeminiSlate.wheelTouch</key><status>0x93</status><midino>0x41</midino><options><Script-Binding/></options></control>

            <!-- ====================================================== -->
            <!-- GLOBAL  -  status 0x93 / 0xB3 (channel 4)              -->
            <!-- ====================================================== -->

            <!-- Central PAD MODE / browse / load -->
            <control><group>[Master]</group><key>GeminiSlate.padModeButton</key><status>0x93</status><midino>0x0D</midino><options><Script-Binding/></options></control>
            <control><group>[Library]</group><key>MoveFocusBackward</key><status>0x93</status><midino>0x07</midino></control>
            <control><group>[Channel1]</group><key>LoadSelectedTrack</key><status>0x93</status><midino>0x03</midino></control>
            <control><group>[Channel3]</group><key>LoadSelectedTrack</key><status>0x93</status><midino>0x01</midino></control>

            <!-- Mixer (direct bindings, range 0..1) -->
            <control><group>[Channel1]</group><key>volume</key><status>0xB3</status><midino>0x07</midino></control>
            <control><group>[QuickEffectRack1_[Channel1]]</group><key>super1</key><status>0xB3</status><midino>0x0B</midino></control>
            <control><group>[EqualizerRack1_[Channel1]_Effect1]</group><key>parameter3</key><status>0xB3</status><midino>0x0F</midino></control>
            <control><group>[EqualizerRack1_[Channel1]_Effect1]</group><key>parameter2</key><status>0xB3</status><midino>0x13</midino></control>
