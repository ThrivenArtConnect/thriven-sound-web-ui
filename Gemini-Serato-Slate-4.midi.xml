            <control><group>[Channel2]</group><key>GeminiSlate.wheelTurn</key><status>0xB1</status><midino>0x04</midino><options><Script-Binding/></options></control>
            <control><group>[Channel2]</group><key>GeminiSlate.rate</key><status>0xB1</status><midino>0x07</midino><options><Script-Binding/></options></control>
            <control><group>[Channel2]</group><key>GeminiSlate.pregain</key><status>0xB1</status><midino>0x08</midino><options><Script-Binding/></options></control>

