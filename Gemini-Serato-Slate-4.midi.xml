            <control><group>[Channel3]</group><key>GeminiSlate.padHotcue</key><status>0x92</status><midino>0x06</midino><options><Script-Binding/></options></control>
            <control><group>[Channel3]</group><key>GeminiSlate.padHotcue</key><status>0x92</status><midino>0x09</midino><options><Script-Binding/></options></control>
