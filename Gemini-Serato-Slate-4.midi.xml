            <control><group>[EqualizerRack1_[Channel4]_Effect1]</group><key>parameter2</key><status>0xB3</status><midino>0x1A</midino></control>
            <control><group>[EqualizerRack1_[Channel4]_Effect1]</group><key>parameter1</key><status>0xB3</status><midino>0x1C</midino></control>

            <!-- Crossfader (script handled, bipolar) -->
            <control><group>[Master]</group><key>GeminiSlate.crossfader</key><status>0xB3</status><midino>0x1B</midino><options><Script-Binding/></options></control>

            <!-- Browse encoder (relative, centered on 0x40) -->
            <control><group>[Library]</group><key>MoveVertical</key><status>0xB3</status><midino>0x1E</midino><options><SelectKnob/></options></control>

        </controls>
    </controller>
</MixxxControllerPreset>
