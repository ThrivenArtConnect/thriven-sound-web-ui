            <control><group>[Channel2]</group><key>GeminiSlate.padSampler</key><status>0x91</status><midino>0x5B</midino><options><Script-Binding/></options></control>
            <control><group>[Channel2]</group><key>GeminiSlate.padSampler</key><status>0x91</status><midino>0x5C</midino><options><Script-Binding/></options></control>

