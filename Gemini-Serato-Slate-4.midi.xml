            <control><group>[EqualizerRack1_[Channel2]_Effect1]</group><key>parameter3</key><status>0xB3</status><midino>0x10</midino></control>
            <control><group>[EqualizerRack1_[Channel2]_Effect1]</group><key>parameter2</key><status>0xB3</status><midino>0x14</midino></control>
            <control><group>[EqualizerRack1_[Channel2]_Effect1]</group><key>parameter1</key><status>0xB3</status><midino>0x18</midino></control>

            <control><group>[Channel3]</group><key>volume</key><status>0xB3</status><midino>0x09</midino></control>
            <control><group>[QuickEffectRack1_[Channel3]]</group><key>super1</key><status>0xB3</status><midino>0x0E</midino></control>
